model TestModel

enum Color {red, green, blue}

class Person
attributes
  name:String
  nicknames:Set(String)
  bestFriend:Person
  age:Integer
  alive:Boolean
  luckyNumbers:Set(Integer)
  favoriteColor:Color
  employerName:String derived = (if self.employerAC.isDefined() then self.employerAC else self.employerA endif).name
  employers:Set(Company) derived = self.employerAC->asSet()
  employerCount:Integer derived = self.employerAC->asSet()->size()
operations
  coworkers():Set(Person) = Person.allInstances()->select(p | p.employerAC = self.employerAC)
  currentEmployer():Company = self.employerAC
  numbersIfAlive():Set(Integer) = if self.alive then Set{1} else Set{2} endif
  named():Boolean = self.name.isDefined()
  sizeOf(numbers:Set(Integer)):Integer = numbers->size()
  noNumbers():Set(Integer) = null
end

class Company
attributes
  name:String
operations
  namedStaff():Set(Person) = self.namedEmployee
  namedStaffBySelect():Set(Person) = Person.allInstances()->select(p | p.namedEmployer = self)
end

class Car
end

class Animal
end

class UndefinedFactory
attributes
  person:Person
  company:Company
  animal:Animal
  job:Job_AC
  parent:Parent_AC
  buy:Buy_AC
  exam:Exam_AC
  numbers:Set(Integer) derived = null
end

association Job_A between
Person[*] role employeeA
Company[0..1] role employerA
end

associationclass Job_AC between
Person[*] role employeeAC
Company[0..1] role employerAC
end

association Parent_A between
Person[0..2] role parentA
Person[*] role childA
end

associationclass Parent_AC between
Person[0..2] role parentAC
Person[*] role childAC
end

association Buy_A between
Person[0..1] role buyerA
Company[0..1] role sellerA
Animal[0..*] role petA
end

associationclass Buy_AC between
Person[0..1] role buyerAC
Company[0..1] role sellerAC
Animal[0..*] role petAC
end

association Exam_A between
  Person[0..*] role examineeA
  Person[0..*] role examinerA
  Person[0..1] role recorderA
end

associationclass Exam_AC between
  Person[0..*] role examineeAC
  Person[0..*] role examinerAC
  Person[0..1] role recorderAC
end

association DerivedJob between
  Person[*] role derivedEmployee
  Company[0..1] role derivedEmployer derived = self.employerAC
end

association DerivedStaff between
  Company[0..1] role staffEmployer
  Person[*] role staff derived = Person.allInstances()->select(employee | employee.employerAC = self)
end

association Unemployment between
  Person[*] role unemployed
  Company[0] role noEmployer
end

association DerivedFriendship between
  Person[0..1] role befriender
  Person[0..1] role derivedFriend derived = self.bestFriend
end

association CheckedJob between
  Person[*] role checkedEmployee
  Company[0..1] role checkedEmployer derived = if self.employerAC.isDefined() then self.employerAC else null endif
end

association NamedJob between
  Person[*] role namedEmployee
  Company[0..1] role namedEmployer derived = if self.name.isDefined() then self.employerAC else null endif
end

association NullStaff between
  Company[*] role nullEmployer
  Person[*] role nullStaff derived = null
end

association StaffFriendship between
  Company[*] role staffFriendEmployer
  Person[*] role staffFriend derived = self.employeeAC->collect(p | p.bestFriend)->asSet()
end

associationclass Idle_AC between
  Person[*] role idler
  Company[0] role idleEmployer
end